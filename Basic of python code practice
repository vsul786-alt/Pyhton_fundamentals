#Simple type
#String type: INDEXED SEQUENCED, this type is ITERABLE(LOOPING), Immutable(non updatable)
my_name = 'uvaraj vs'
print(my_name[0])
print(my_name[-1])
print(my_name[-3])
print(type(my_name))
print(my_name.capitalize())
print(my_name.title())
print(my_name.lower())
print(my_name.upper())

#Iterable (loopable)
for letter in my_name:
    print(letter)
    print(letter.isalpha())
    print(letter.isdigit())
    print(letter.isalnum())
    print(letter.isspace())
    print(letter.istitle())
    print(letter.isupper())
    print(letter.islower())
    print(letter.isnumeric())
    print(letter.isdecimal())

